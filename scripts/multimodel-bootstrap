#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

tool="${1:-}"
if [[ -z "$tool" ]]; then
  echo "Usage: multimodel-bootstrap <codex|claude|gemini|cursor>" >&2
  exit 1
fi

case "$tool" in
  codex)
    src="adapters/codex/AGENTS.md"
    dest=".agent-adapters/codex/AGENTS.md"
    ;;
  claude)
    src="adapters/claude/CLAUDE.md"
    dest=".agent-adapters/claude/CLAUDE.md"
    ;;
  gemini)
    src="adapters/gemini/GEMINI.md"
    dest=".agent-adapters/gemini/GEMINI.md"
    ;;
  cursor)
    src="adapters/cursor/rules.md"
    dest=".agent-adapters/cursor/rules.md"
    ;;
  *)
    echo "Unknown tool: $tool" >&2
    exit 1
    ;;
esac

mkdir -p "$(dirname "$dest")"
cp "$src" "$dest"
echo "bootstrapped $tool adapter at $dest"
